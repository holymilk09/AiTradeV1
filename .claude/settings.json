{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "mcpServers": {
    "alpaca": {
      "command": "uvx",
      "args": ["--from", "alpaca-mcp-server", "alpaca-mcp-server"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY}",
        "ALPACA_SECRET_KEY": "${ALPACA_SECRET_KEY}",
        "ALPACA_PAPER_TRADE": "true"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff check*)",
      "Bash(uv run mypy*)",
      "Bash(uv run aitrade verify*)",
      "Bash(uv run aitrade backtest*)",
      "Bash(uv run aitrade analyze*)",
      "Bash(uv run aitrade strategies*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ]
  }
}
