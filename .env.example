# Alpaca credentials (paper keys from https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret

# Live-trade guardrail. Leave false. Setting true alone does NOT enable live trading;
# the broker factory also requires confirm_live=True at the call site.
ALPACA_LIVE_TRADE=false

# Data + log locations (relative paths allowed)
AITRADE_DATA_DIR=./data
AITRADE_LOG_DIR=./logs

# Logging
AITRADE_LOG_LEVEL=INFO

# Risk defaults (can be overridden per-strategy)
AITRADE_MAX_POSITION_USD=5000
AITRADE_MAX_DAILY_LOSS_USD=500
AITRADE_MAX_ORDERS_PER_MIN=20

# LLM reasoner — Anthropic Claude API key (same one you use with Claude Code).
# The reasoner reads indicators + position state and decides buy/sell/hold.
# Leave blank to run the bot without LLM reasoning (indicator-only strategies).
ANTHROPIC_API_KEY=
AITRADE_REASONER_MODEL=claude-opus-4-7
# Minimum seconds between reasoner calls per symbol — bounds token cost.
AITRADE_REASONER_MIN_GAP_SECS=300

# Phase 1 — signal engine
# Engine cycle interval (seconds). 900s = 15 min. Each cycle: discovery + pattern
# scan + reasoner call. Bounded cost.
AITRADE_ENGINE_INTERVAL_SECS=900
# Top N tickers from discovery to scan for patterns each cycle.
AITRADE_DISCOVERY_TOP_N=20
# MarketSnapshot freshness — refetch if cached snapshot older than TTL; refuse
# to use it if older than max_stale.
AITRADE_MARKET_SNAPSHOT_TTL_SECS=30
AITRADE_MARKET_SNAPSHOT_MAX_STALE_SECS=300

# Phase 2 — news + economic calendar context
# Alpaca News API uses your existing Alpaca creds — no new key needed.
# AITRADE_NEWS_PER_SYMBOL bounds how many headlines per symbol go into the
# floor-trader prompt; AITRADE_NEWS_LOOKBACK_HOURS controls freshness.
AITRADE_NEWS_LOOKBACK_HOURS=24
AITRADE_NEWS_PER_SYMBOL=3
# FMP free tier (250 req/day): https://site.financialmodelingprep.com/
# Used for the upcoming US economic calendar (Fed/CPI/NFP/GDP/...) +
# earnings calendar. Leave blank to disable; engine still runs without it.
FMP_API_KEY=
AITRADE_CALENDAR_DAYS_AHEAD=7
